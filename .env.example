# Server Configuration
HOST=0.0.0.0
PORT=4000
DEBUG=False

# LLM Provider Configuration ('gemini' or 'openai')
# Default recommended provider: gemini
LLM_PROVIDER=gemini

# Google Gemini Settings (Recommended: Fastest, Lowest Cost, Native JSON Schema)
# Model options: gemini-2.0-flash, gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI Settings (Alternative fallback)
# Model options: gpt-4o-mini, gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Web Scraping & Extractor Settings
SCRAPE_TIMEOUT_SECONDS=15
MAX_EXTRACTED_CHARACTERS=18000
